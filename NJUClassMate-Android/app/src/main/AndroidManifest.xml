<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 抓课表、显示网页 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 开机自启：重启后恢复定时刷新任务。Android 这边是官方支持的，不像鸿蒙有限制 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 上课提醒（Android 13+ 需要运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟：课前提醒要卡在整点上，普通闹钟会被系统延迟几分钟。
         API 31+ 需要在系统设置里授权，代码里会检测并降级。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      请求忽略电池优化。

      国产 ROM（尤其是华为 EMUI / 鸿蒙）对三方应用的后台管控比原生严格得多：
      不加入白名单时应用会被冻结，闹钟不响、小组件和锁屏通知停在旧数据上。

      注意：Google Play 对这条权限有上架限制（需要说明用途），
      但本应用是自签名侧载分发、不上 Play，所以没有这个约束。
      设置页把"允许后台运行"做成了一个可点的适配项，用户随时能自主决定。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NJUClassMate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 内置浏览器导入。单独一个 Activity，
             这样"看课表"和"登录教务系统"两个 WebView 互不干扰。 -->
        <activity
            android:name=".ImportActivity"
            android:exported="false"
            android:label="@string/import_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 桌面小组件：下一节课（2x2 / 4x2）
             必须给 android:label —— 否则「添加小部件」列表里两个小组件
             都会显示应用名（南哪儿课表），用户根本分不清哪个是哪个。 -->
        <receiver
            android:name=".widget.NextClassWidget"
            android:exported="false"
            android:label="@string/widget_next_class">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_class_info" />
        </receiver>

        <!-- 桌面小组件：今日课表（4x2 / 4x4） -->
        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 开机自启：重启后重新排班 -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 上课提醒的闹钟接收器 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 锁屏常驻通知里两个按钮（刷新 / 看明天）的落点。
             只接收自己造的 PendingIntent，所以不导出。
             注意：Android 8 起 ACTION_SCREEN_OFF 不能静态注册，
             息屏刷新用的是动态注册（见 App.onCreate）。 -->
        <receiver
            android:name=".notify.NotifyActionReceiver"
            android:exported="false" />

    </application>

</manifest>
